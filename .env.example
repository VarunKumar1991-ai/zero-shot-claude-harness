AGENT_DATABASE_URL=sqlite:///./data/agent.db

# LLM provider — auto-detected from whichever key is set below.
# Override explicitly: anthropic | gemini
# AGENT_LLM_PROVIDER=gemini

# Override model (uses provider default when blank):
# AGENT_LLM_MODEL=claude-sonnet-4-6   (Anthropic default)
# AGENT_LLM_MODEL=gemini-3.1-pro       (Gemini default, quality-sensitive nodes)
# AGENT_LLM_FAST_MODEL=gemini-2.5-flash (fast classification/assessment node)

# Set exactly ONE provider key:
AGENT_ANTHROPIC_API_KEY=
AGENT_GEMINI_API_KEY=

# --- UP Police Data Analyst Agent settings ---
# Local storage for uploaded CSVs and the converted Parquet dataset store
AGENT_UPLOAD_DIR=./data/uploads
AGENT_DATASET_STORE_DIR=./data/datasets
# Max accepted CSV size in MB
AGENT_MAX_CSV_MB=100
# Hard timeout (seconds) for sandboxed analysis code execution
AGENT_SANDBOX_TIMEOUT_SECONDS=20
# Max internal retries when generated code fails/produces a bad result
AGENT_MAX_CODE_RETRIES=3
# Number of prior conversation turns loaded as context for follow-up questions
AGENT_CONVERSATION_HISTORY_TURNS=5
# Session cookie TTL (hours)
AGENT_SESSION_TTL_HOURS=12
# Data source backend — swappable; only "local_parquet" is implemented in Phase 1-3
AGENT_DATA_SOURCE=local_parquet

PORT=8001
