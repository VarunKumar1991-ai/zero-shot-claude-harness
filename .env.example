# --- Server ---
PORT=8001
NODE_ENV=development

# --- Database (SQLite via Sequelize; swappable dialect for future MySQL) ---
AGENT_DATABASE_URL=sqlite:./data/agent.db

# --- LLM provider: Google Gemini ---
AGENT_GEMINI_API_KEY=
AGENT_LLM_MODEL_PRIMARY=gemini-3.1-pro
AGENT_LLM_MODEL_FAST=gemini-2.5-flash

# --- Auth ---
AGENT_JWT_SECRET=

# --- Observability (optional) ---
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
